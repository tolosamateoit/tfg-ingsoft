# Copiar a backend/.env y completar localmente. No guardar credenciales aquí.
# Usar los valores exactos de Connect > Session pooler en Supabase.
PGHOST=
PGPORT=5432
PGDATABASE=postgres
PGUSER=
# Entre comillas simples para conservar espacios, # y otros caracteres.
PGPASSWORD=''

# Certificado raíz descargado desde Database settings > SSL Configuration.
# La ruta relativa se resuelve desde backend/, independientemente de la terminal.
PGSSLMODE=verify-full
PGSSLROOTCERT=certs/supabase-ca.crt
PGCONNECT_TIMEOUT=5
