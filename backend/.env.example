# Copiar a backend/.env y completar localmente. No guardar credenciales aquí.
# Usar los valores exactos de Connect > Session pooler en Supabase.
PGHOST=
PGPORT=5432
PGDATABASE=postgres
PGUSER=
# Entre comillas simples para conservar espacios, # y otros caracteres.
PGPASSWORD=''

# Conexión cifrada sin certificado local.
PGSSLMODE=require
PGCONNECT_TIMEOUT=5

# HU-01: desarrollo local. En producción: true y origen HTTPS exacto del frontend.
# No usar '/' al final de los orígenes ni comodines. Sin CORS público.
AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
